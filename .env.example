# Supabase — public anon key only. NEVER commit the service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public URL, no trailing slash (sitemap / hreflang / OG tags).
NEXT_PUBLIC_SITE_URL=

# GitHub Pages sub-path: "" for a custom domain or user site, "/repo-name" otherwise.
NEXT_PUBLIC_BASE_PATH=
